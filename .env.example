# Application environment mode ("production" or "development")
ENVIRONMENT=production

# Facility JWT secret key used to verify incoming user tokens
JWT_SECRET=your-facility-jwt-secret

# Comma-separated list of allowed JWT signature algorithms
JWT_ALGORITHMS=HS256

# External Permissions API endpoint used to verify user role scopes
PERMISSIONS_API=https://permissions-api.cpguardian.com/api

# Azure Cosmos DB account HTTPS endpoint URL
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# Read-only Cosmos DB key used strictly for accessing business data containers (batches, equipment, etc.)
COSMOS_DB_READONLY_KEY=your-cosmos-readonly-key

# Write-scoped Cosmos DB key used strictly for audit logs and chat history containers
COSMOS_DB_WRITE_KEY=your-cosmos-write-key

# Target Cosmos DB database name for CPG compliance data
COSMOS_DB_DATABASE=cpg_compliance

# Cosmos DB container name for storing immutable audit trail records
COSMOS_DB_AUDIT_CONTAINER=audit_trail

# Cosmos DB container name for storing threaded user chat histories
COSMOS_DB_CHAT_CONTAINER=chat_history

# Permitted frontend origin URL for production CORS locking
FRONTEND_ORIGIN=https://app.cpguardian.com

# Production check variable for backward-compatible environment verification
MONGODB_URI=mongodb://placeholder:27017

# Comma-separated allowed CORS origins for development environments
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# LLM provider choice: "openai", "gemini", or "ollama"
AI_PROVIDER=openai

# Model identifier (e.g., gpt-4o-mini, gemini-2.0-flash, llama3.2)
AI_MODEL=gpt-4o-mini

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Azure OpenAI endpoint (optional when using Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI API version string
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Gemini API key (required when AI_PROVIDER=gemini)
AI_API_KEY=your-gemini-api-key

# Local Ollama HTTP base URL (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Facility API endpoint for fallback operations
FACILITY_API=https://facility-user-api.cpguardian.com/api

# Production API endpoint for fallback operations
PRODUCTION_API=https://production-api.cpguardian.com/api

# Compliance API endpoint for fallback operations
COMPLIANCE_API=https://compliance-api.cpguardian.com/api

# Default facility tenant collection identifier
COLLECTION_ID=sales

# Application environment mode ("production" or "development")
ENVIRONMENT=production

# External Permissions API endpoint used to verify user identity & roles (replaces local JWT secret)
PERMISSIONS_API=https://sales.cpguardian.com/users/roles

# Facility and domain microservice API URLs
FACILITY_API=https://facility-user-api.cpguardian.com/api/
PRODUCTION_API=https://production-api.cpguardian.com/api/
COMPLIANCE_API=https://compliance-api.cpguardian.com/api/
ORDER_API=https://order-api.cpguardian.com/api/
NOTIFICATION_HUB_API=https://notification-api.cpguardian.com/

# Permitted frontend origin URL for production CORS locking
FRONTEND_ORIGIN=https://app.cpguardian.com

# Comma-separated allowed CORS origins for development environments (e.g. Next.js on 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000

# LLM provider choice: "openai", "gemini", or "ollama"
AI_PROVIDER=openai

# Model identifier (e.g., gpt-4o-mini, gemini-2.0-flash, llama3.2)
AI_MODEL=gpt-4o-mini

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Azure OpenAI endpoint (optional when using Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI API version string
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Default facility tenant collection identifier
COLLECTION_ID=sales

